using System;

namespace MultipleTableGeneration
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Enter the number you want to generate the multiple table for:");
            int number = Convert.ToInt32(Console.ReadLine());

            for (int i = 1; i <= 10; i++)
            {
                Console.WriteLine("{0} x {1} = {2}", number, i, number * i);
            }
        }
    }
}
